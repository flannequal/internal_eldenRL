                <CheatEntry>
                  <ID>1337304717</ID>
                  <Description>"Invoke Warp"</Description>
                  <Options moAlwaysHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

{$lua}
function disableSelf(sender)
  sender.destroy()
  local addr=getAddressList().getMemoryRecordByDescription("Invoke Warp")
  memoryrecord_unfreeze(addr)
end

local t=createTimer(nil)
t.OnTimer=disableSelf
t.Interval=1000
t.Enabled=true
{$asm}

createthread(Warp)
[DISABLE]

</AssemblerScript>
