              <Description>"No Camera Bound"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobScanModule(SetCameraBound,eldenring.exe,F3 44 0F 11 9B 58 02 00 00 F3 44 0F 59 EE)
alloc(CameraBoundHook,2048)
CameraBoundHook:
mov dword ptr[rbx+00000258],bfc80000
mov dword ptr[rbx+0000025C],3fc80000
mulss xmm13,xmm6
ret

SetCameraBound:
