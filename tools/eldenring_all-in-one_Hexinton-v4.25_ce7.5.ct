      KillAllMobsGood:refId(10641000)
      KillAllMobsGood:patchBinary(0x48,0,7)
      KillAllMobsGood:patch2Byte(0x30,99)
local KillAllMobsBullet = Bullet:new("KAMB",10641000)
      KillAllMobsBullet:life(10)
      KillAllMobsBullet:hitRadius(5000)
      KillAllMobsBullet:isPenetrate(1)
local KillAllMobsAtk = AtkParam_Pc:new("KAMA",64100)
      KillAllMobsAtk:AtkPhys(65535)
      KillAllMobsAtk:AtkMag(65535)
      KillAllMobsAtk:AtkFire(65535)
      KillAllMobsAtk:AtkThun(65535)
