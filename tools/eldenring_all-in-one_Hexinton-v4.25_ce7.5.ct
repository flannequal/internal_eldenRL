                  <AssemblerScript>[ENABLE]
alloc(ProjectileCreate,$500,eldenring.exe)
registersymbol(ProjectileCreate)

aobscanmodule(BulletSpawnCall,eldenring.exe,40 53 55 56 57 48 81 EC 98 07 00 00 48 C7 44 24 ?? ?? ?? ?? ?? 48 8B 05 ?? ?? ?? ?? 48 33 C4)
