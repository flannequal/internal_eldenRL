itembuffer:
dq 0,0,0,0,F00006AE00000001,0000000000000001,FFFFFFFFFFFFFFFF,FFFFFFFF00000000,FFFFFFFFFFFFFFFF,FFFFFFFF00000000
itemgib:
mov rdx,rcx
cmp rdx,10000
jge itemgib1
lea rdx,[itembuffer+20]
itemgib1:
