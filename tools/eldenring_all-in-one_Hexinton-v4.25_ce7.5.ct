[ENABLE]
{$c}
#include &lt;tga/params.h&gt;
int on_enable() {
    ParamPatchBegin("shops_access");
    ParamPatchAll(ShopLineupParam, {
        param-&gt;eventFlag_forRelease = -1;
    });
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("shops_access");
    return 0;
}

