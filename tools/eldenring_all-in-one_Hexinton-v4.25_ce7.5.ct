                      <ID>1337190302</ID>
                      <Description>"Custom Magic Tutorial (Pebble)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{Made by Zodiacsl125
01/10/2022}
[ENABLE]
{$lua}
if syntaxcheck then return end
local magic = Magic:new("MagicTutorial",4000) --changing pebble
magic:patch4Byte(0x68,2200410) --the replace spell
magic:Mp(100) --no fp cost
magic:Stamina(0) --no stamina cost
magic:patch4Byte(0x22,30) --Int needed
magic:patch4Byte(0x23,99) --Faith needed
magic:patch4Byte(0xE,60) --Arcane needed

local good = EquipParamGoods:new("GoodTutorial",4000) --changing pebble
good:patch4Byte(0x30,666) --replace icon

local attack = AtkParam_Pc:new("AttackTutorial",2200410) --changing pebble
attack:patch4Byte(0x50,300) --physical dmg
attack:patch4Byte(0x56,2700) --lightning dmg

local bullet = Bullet:new("BulletTutorial",2200410) --changing pebble
bullet:patch4Byte(0x44,100) --hitbox

[DISABLE]
{$lua}
if syntaxcheck then return end
paramUtils:restore("MagicTutorial")
paramUtils:restore("GoodTutorial")
paramUtils:restore("AttackTutorial")
paramUtils:restore("BulletTutorial")
</AssemblerScript>
