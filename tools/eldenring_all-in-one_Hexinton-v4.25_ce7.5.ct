xor r9,r9
lea r8,[itembuffer]
mov rax,InventoryAccessor+19
mov rcx,InventoryAccessor+1D
mov eax,[rax]
cdqe
add rcx,rax
mov rcx,[rcx]
cmp rcx,10000
jl exit
call AddItemFunc
exit:
add rsp,28
ret
