                  <Description>"Perform Gestures"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
PlayGesture=AOBScanModuleUnique("eldenring.exe","40 57 48 83 EC 20 48 8B 05 ?? ?? ?? ?? 48 8B F9 48 85 C0 75 2E 48 8D 0D","+X")
GestureBuffer=allocateMemory(64)
writeInteger(GestureBuffer+16,22)
getAddressList().getMemoryRecordByID(77345).Address=string.format("%x",GestureBuffer+16)
[DISABLE]
{$lua}
deAlloc(GestureBuffer)
PlayGesture=nil
</AssemblerScript>
