alloc(BulletManAob,$600)
registersymbol(BulletManAob)

alloc(BulletManOutput,$300)
registersymbol(BulletManOutput)

alloc(BulletHandle,4)
registersymbol(BulletHandle)

BulletManAob+80:
readmem([[[[WorldChrMan]+1E508]+190]+68]+70, 12)

BulletManAob+14:
 dd #10401000

ProjectileCreate:

mov rcx,[BULLET_MAN]
lea r8,[BulletManAob]
lea r9,[BulletManOutput]
lea rdx,[BulletHandle]
sub rsp,28
call BulletSpawnCall

add rsp,28
ret

[DISABLE]
