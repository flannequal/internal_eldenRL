              <AssemblerScript>[ENABLE]

aobscanmodule(rune_multiplier,eldenring.exe,f3 0f 59 c1 f3 0f 2c f8 48 8b 8b) // should be unique
alloc(newmem,$1000,rune_multiplier)

label(code)
label(return)
label(rn_mult)
registersymbol(rn_mult)

newmem:
  movss xmm0, [rn_mult]
code:
  mulss xmm0,xmm1
