                <CheatEntry>
                  <ID>1337251121</ID>
                  <Description>"Global Parry"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
local finder=AOBScanModuleUnique("eldenring.exe","0F B6 1D ?? ?? ?? ?? 48 8B 86 90 01 00 00 48 8B 48 08 48 8B 41 40 48 C1 E8 24 A8 01 74 09","+X")
if finder then
   GlobalParryFlag=finder+7+readInteger(finder+3,true)
   writeByte(GlobalParryFlag,1)
end
[DISABLE]
{$lua}
if GlobalParryFlag then
writeByte(GlobalParryFlag,0)
end
</AssemblerScript>
