                <CheatEntry>
                  <ID>1337304928</ID>
                  <Description>"Kill Character"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

{$lua}
function disableSelf(sender)
  sender.destroy()
  local addr=getAddressList().getMemoryRecordByDescription("Kill Character")
  memoryrecord_unfreeze(addr)
end

local t=createTimer(nil)
t.OnTimer=disableSelf
t.Interval=100
t.Enabled=true
{$asm}

[[WorldChrMan]+1E508]+1C5:

db 88

[DISABLE]

</AssemblerScript>
