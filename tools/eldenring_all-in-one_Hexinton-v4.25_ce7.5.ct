              <ID>1337192510</ID>
              <Description>"Add Runes"</Description>
              <Options moHideChildren="1"/>
              <Color>0080FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{Author:inuNorii}
[ENABLE]
aobscanmodule(AddSoul_Call,eldenring.exe,44 8B 49 6C 45 33 DB)
alloc(AddSoul,$100,eldenring.exe)
registerSymbol(AddSoul)
label(AddSoulData)

AddSoul:
sub rsp,48
mov edi,[AddSoulData]
mov rcx,[WorldChrMan]
mov rcx,[rcx+000010EF8]
mov rcx,[rcx]
mov rcx,[rcx+00000580]
mov edx,edi
call AddSoul_Call
add rsp,48
ret

AddSoulData:
registerSymbol(AddSoulData)
dd #125000000

[DISABLE]
dealloc(AddSoul)
unregisterSymbol(AddSoul)
unregisterSymbol(AddSoulData)
</AssemblerScript>
