                <CheatEntry>
                  <ID>1337304934</ID>
                  <Description>"Aggression Mod (restart to disable)"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
alloc(AggressionMod,512,eldenring.exe)
registersymbol(AggressionMod)

label(LoopAgr)
label(OverwriteShort)

createthread(AggressionMod)

AggressionMod:
xor ecx,ecx
mov r15d,40

mov rax,[PARAM] // PARAM
mov rax,[rax+310] //NpcThinkParam
mov rax,[rax+80]
mov rax,[rax+80]
LoopAgr:
movzx ebx,word ptr [rax+0A] //Param Field Num (Condition for loop)
lea rdx,[rax+r15d]

mov r11d,[rdx+08]
lea r12,[rax+r11d]

mov r13d,(float)9999
mov [r12+28],r13d //ear dist
mov r13d,#9999
call OverwriteShort //other values

lea r15d,[r15+18]
inc ecx
cmp ecx,ebx
jl LoopAgr
ret

OverwriteShort: //other values
mov [r12+34],r13w
mov [r12+3A],r13w
mov [r12+3C],r13w
mov [r12+3E],r13w
mov [r12+40],r13w
ret


[DISABLE]
dealloc(AggressionMod)
unregistersymbol(AggressionMod)
</AssemblerScript>
