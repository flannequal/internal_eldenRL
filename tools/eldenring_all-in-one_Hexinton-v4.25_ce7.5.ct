                      <AssemblerScript>{Made by Zodiacsl125}
[ENABLE]
{$lua}
if syntaxcheck then return end
local Inf = SpEffectParam:new("InfiniteDuration",IDHere)
Inf:effectEndurance(-1) -- effectEndurance

