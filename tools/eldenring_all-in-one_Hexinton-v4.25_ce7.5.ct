            <CheatEntry>
              <ID>1337304926</ID>
              <Description>"Show all Graces"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
autoAssemble([[
aobscanmodule(Finder,eldenring.exe,0F B6 0D xx xx xx xx E8 xx xx xx xx 44 8B E0)
registersymbol(Finder)
]])
local addr = getAddress("Finder")
addr = addr + readInteger(addr + 3) + 7
unregisterSymbol("Finder")
registerSymbol("NewMenuSystemWarp2", addr, true)
{$asm}

NewMenuSystemWarp2+1:
db 01

NewMenuSystemWarp2:
db

[DISABLE]

NewMenuSystemWarp2+1:
db 00

NewMenuSystemWarp2:
db 00
</AssemblerScript>
