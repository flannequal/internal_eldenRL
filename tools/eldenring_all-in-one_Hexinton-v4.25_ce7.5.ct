{$lua}
function disableSelf(sender)
  sender.destroy()
  local addr=getAddressList().getMemoryRecordByDescription("AddItem_")
  memoryrecord_unfreeze(addr)
end
 
local t=createTimer(nil)
t.OnTimer=disableSelf
t.Interval=100
t.Enabled=true
disableMemrec(memrec)
