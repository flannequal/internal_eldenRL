                  <AssemblerScript>[ENABLE]
aobscanmodule(craftitem,eldenring.exe,0f 4f f8 48 83 c3) // should be unique
registersymbol(craftitem)
aobscanmodule(smith_rune_cost,eldenring.exe,83 38 ? 4c 0f 4f c0) // should be unique
alloc(newmem,$1000,smith_rune_cost)
aobscanmodule(no_smith_cost,eldenring.exe,8B 7B 0C 48 8B C8) // should be unique
alloc(newmem1,$1000,no_smith_cost)
aobscanmodule(free_craft_mat,eldenring.exe,0f b7 50 ? 66 3b ca 77) // should be unique
alloc(newmem2,$1000,free_craft_mat)

craftitem:
  nop 3

label(code)
label(return)
label(code1)
label(return1)
label(no_smith_costread)
registersymbol(no_smith_costread)
label(code2)
label(return2)
label(free_craft_matread)
registersymbol(free_craft_matread)

newmem:
  mov [rax],#0
code:
  cmp dword ptr [rax],00
  cmovg r8,rax
  jmp return

newmem1:
  db C7 43
  readmem(no_smith_cost+2,1)            // mov [rbx+0C], 0
  db 00 00 00 00
 code1:
  readmem(no_smith_cost,6)
  jmp return1

no_smith_costread:
 readmem(no_smith_cost,6)

newmem2:
  db 66 C7 40
  readmem(free_craft_mat+3,1)     //mov word ptr [rax+1A], 0
  db 00 00
code2:
  readmem(free_craft_mat,7)
  jmp return2

free_craft_matread:
 readmem(free_craft_mat,7)

smith_rune_cost:
  jmp newmem
  nop 2
return:
registersymbol(smith_rune_cost)

no_smith_cost:
  jmp newmem1
  nop
return1:
registersymbol(no_smith_cost)

free_craft_mat:
  jmp newmem2
  nop 2
return2:
registersymbol(free_craft_mat)


