          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Author: Coinsworth
[ENABLE]
aobscanmodule(LuaWarp_01_AOB,eldenring.exe,C3 ?? ?? ???????? 57 48 83 EC ?? 48 8B FA 44)
define(LuaWarp_01,LuaWarp_01_AOB+2)
alloc(Warp,$100,eldenring.exe)
label(WarpLocation)
registersymbol(Warp)
registersymbol(WarpLocation)

Warp:
sub rsp,48
mov rax,[CSLuaEventManager]
mov rcx,[rax+18]
mov rdx,[rax+08]
mov eax,[WarpLocation]
lea r8d,[eax-000003E8]
call LuaWarp_01
add rsp,48
ret

WarpLocation:
dd #1042362951

[DISABLE]
dealloc(Warp)
unregistersymbol(Warp)
unregistersymbol(WarpLocation)
</AssemblerScript>
