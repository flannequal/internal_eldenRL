                    <CheatEntry>
                      <ID>1337214605</ID>
                      <Description>"Apply_Effect"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[enable]
{$lua}
function disableSelf(timer)
  timer.destroy()
  local addr=getAddressList().getMemoryRecordByDescription("Apply_Effect")
  memoryrecord_unfreeze(addr)
end
local t=createTimer(nil)
t.OnTimer=disableSelf
t.Interval=100
t.Enabled=true
{$asm}
CREATETHREAD(ApplyEffect)
[disable]
</AssemblerScript>
