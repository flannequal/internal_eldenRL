            <CheatEntry>
              <ID>1337309266</ID>
              <Description>"Twin Maiden Husk"</Description>
              <Options moHideChildren="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337309321</ID>
                  <Description>"These Flags change if the Twin Maiden Husk Received a Bearing or not"</Description>
                  <Color>008000</Color>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337309322</ID>
                  <Description>"--------------------------------------------------"</Description>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337309333</ID>
                  <Description>"Remove all Bearings/Add all Bearings"</Description>
                  <Color>4080FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Made by Zei
[ENAble]
//Removes all Bearings from Husk
{$asm}
[[EventFlagMan]+28]+153A6D:
dd #0
[[EventFlagMan]+28]+153A6E:
dd #0
[[EventFlagMan]+28]+153A6F:
dd #0
[[EventFlagMan]+28]+153A70:
dd #0
[[EventFlagMan]+28]+153A71:
dd #0
[[EventFlagMan]+28]+153A72:
dd #0
[[EventFlagMan]+28]+153A73:
dd #0
[[EventFlagMan]+28]+153A74:
dd #0
[DISABLE]
//Adds all Bearings to Husk
{$asm}
[[EventFlagMan]+28]+153A6D:
dd #255
[[EventFlagMan]+28]+153A6E:
dd #255
[[EventFlagMan]+28]+153A6F:
dd #255
[[EventFlagMan]+28]+153A70:
dd #255
[[EventFlagMan]+28]+153A71:
dd #255
[[EventFlagMan]+28]+153A72:
dd #255
[[EventFlagMan]+28]+153A73:
dd #255
[[EventFlagMan]+28]+153A74:
dd #255


</AssemblerScript>
                </CheatEntry>
