                      <ID>1337309155</ID>
                      <Description>"Coordinates"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ 
  Game Executable   : eldenring.exe
  Executable Version: 1.8.1.0
  Module Version    : 
  Script Date       : 06/01/2023
  Author 			: Akira Fudo
  
0F 10 41 70 48 8B C2 0F 29 02 C3 90 EC
0F 10 ? ? 48 8B ? 0F 29 ? C3 90 EC
0F 10 ?? ?? 48 8B ?? 0F 29 ?? C3 90 EC
}

[ENABLE]

aobscanmodule(Coordinates_AoB,$process,0F 10 ?? ?? 48 8B ?? 0F 29 ?? C3 90 EC)
alloc(Coordinates_Newmem,$200,Coordinates_AoB)
alloc(Coordinates_BackupBytes,7,Coordinates_AoB)
alloc(pCoordinateRead_X,4)
alloc(pCoordinateRead_Y,4)
alloc(pCoordinateRead_Z,4)
alloc(pCoordinateSave_X,4)
alloc(pCoordinateSave_Y,4)
alloc(pCoordinateSave_Z,4)
alloc(pCoordinate_Save,1)
alloc(pCoordinate_Load,1)
alloc(eCoordinate_Load,1)
alloc(eCoordinate_Load2,1)

label(Coordinates_Return)
label(Coordinates_OriginalCode)
label(pLoad)
label(entity)
label(entity2)

Coordinates_BackupBytes:
  readmem(Coordinates_AoB,7)

Coordinates_Newmem:
  cmp [NpcCoordinates_Pointer],rcx
  je entity
  cmp [PlayerCoordinates_Pointer],rcx
  jne entity
  mov [pCoordinates_Pointer],rcx
  movss xmm0,[rcx+70] //;Enter Offset of X
  movss [pCoordinateRead_X],xmm0
  movss xmm0,[rcx+70+4] //;Enter Offset of Y
  movss [pCoordinateRead_Y],xmm0
  movss xmm0,[rcx+70+8] //;Enter Offset of Z
  movss [pCoordinateRead_Z],xmm0
  cmp byte ptr [pCoordinate_Save],00
  je pLoad
  movss xmm0,[rcx+70] //;Enter Offset of X
  movss [pCoordinateSave_X],xmm0
  movss xmm0,[rcx+70+4] //;Enter Offset of Y
  movss [pCoordinateSave_Y],xmm0
  movss xmm0,[rcx+70+8] //;Enter Offset of Z
  movss [pCoordinateSave_Z],xmm0
  jmp Coordinates_OriginalCode
  
pLoad:
  cmp byte ptr [pCoordinate_Load],00
  je Coordinates_OriginalCode
  cmp dword ptr [pCoordinateSave_X],00
  je Coordinates_OriginalCode
  movss xmm0,[pCoordinateSave_X]
  movss [rcx+70],xmm0 //;Enter Offset of X
  movss xmm0,[pCoordinateSave_Y]
  movss [rcx+70+4],xmm0 //;Enter Offset of Y
  movss xmm0,[pCoordinateSave_Z]
  movss [rcx+70+8],xmm0 //;Enter Offset of Z
  jmp Coordinates_Return
  
entity:
  mov [eCoordinates_Pointer],rcx
  cmp byte ptr [eCoordinate_Load],00
  je entity2
  cmp dword ptr [pCoordinateSave_X],00
  je Coordinates_OriginalCode
  movss xmm0,[pCoordinateSave_X]
  movss [rcx+70],xmm0 //;Enter Offset of X
  movss xmm0,[pCoordinateSave_Y]
  movss [rcx+70+4],xmm0 //;Enter Offset of Y
  movss xmm0,[pCoordinateSave_Z]
  movss [rcx+70+8],xmm0 //;Enter Offset of Z
  jmp Coordinates_Return

entity2:
  cmp byte ptr [eCoordinate_Load2],00
  je Coordinates_OriginalCode
  movss xmm0,[pCoordinateRead_X]
  movss [rcx+70],xmm0 //;Enter Offset of X
  movss xmm0,[pCoordinateRead_Y]
  movss [rcx+70+4],xmm0 //;Enter Offset of Y
  movss xmm0,[pCoordinateRead_Z]
  movss [rcx+70+8],xmm0 //;Enter Offset of Z
  jmp Coordinates_Return

Coordinates_OriginalCode:
  readmem(Coordinates_AoB,7)
  {
  movups xmm0,[rcx+70]
  mov rax,rdx
  }
  jmp Coordinates_Return
  
pCoordinates_Pointer:
  dq 0

eCoordinates_Pointer:
  dq 0

Coordinates_AoB:
  jmp Coordinates_Newmem
  nop 2
Coordinates_Return:
registersymbol(Coordinates_AoB)
registersymbol(pCoordinates_Pointer)
registersymbol(eCoordinates_Pointer)
registersymbol(pCoordinateRead_X)
registersymbol(pCoordinateRead_Y)
registersymbol(pCoordinateRead_Z)
registersymbol(pCoordinateSave_X)
registersymbol(pCoordinateSave_Y)
registersymbol(pCoordinateSave_Z)
registersymbol(pCoordinate_Save)
registersymbol(pCoordinate_Load)
registersymbol(eCoordinate_Load)
registersymbol(eCoordinate_Load2)
registersymbol(Coordinates_BackupBytes)


[DISABLE]


Coordinates_AoB:
  readmem(Coordinates_BackupBytes,7)

unregistersymbol(Coordinates_AoB)
unregistersymbol(pCoordinates_Pointer)
unregistersymbol(eCoordinates_Pointer)
unregistersymbol(pCoordinateRead_X)
unregistersymbol(pCoordinateRead_Y)
unregistersymbol(pCoordinateRead_Z)
unregistersymbol(pCoordinateSave_X)
unregistersymbol(pCoordinateSave_Y)
unregistersymbol(pCoordinateSave_Z)
unregistersymbol(pCoordinate_Save)
unregistersymbol(pCoordinate_Load)
unregistersymbol(eCoordinate_Load)
unregistersymbol(eCoordinate_Load2)
unregistersymbol(Coordinates_BackupBytes)
dealloc(Coordinates_Newmem)
dealloc(pCoordinateRead_X)
dealloc(pCoordinateRead_Y)
dealloc(pCoordinateRead_Z)
dealloc(pCoordinateSave_X)
dealloc(pCoordinateSave_Y)
dealloc(pCoordinateSave_Z)
dealloc(pCoordinate_Save)
dealloc(pCoordinate_Load)
dealloc(eCoordinate_Load)
dealloc(eCoordinate_Load2)
dealloc(Coordinates_BackupBytes)

