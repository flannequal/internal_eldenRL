        <CheatEntry>
          <ID>1337199163</ID>
          <Description>"[ Teleport, Coords, NoClip/FreeCam ]"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : eldenring.exe
  Version: 
  Date   : 2022-03-08
  Author : asd

  This script does blah blah blah
}

{ Game   : eldenring.exe
  Version: 
  Date   : 2022-03-08
  Author : asd

  This script does blah blah blah
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(pCoordTemp,128,eldenring.exe+45E559)
registersymbol(pCoordTemp)
define(pCoordAdr,[[[[[WorldChrMan]+1E508]+58]+10]+190]+68)
registersymbol(pCoordAdr)


aobscanmodule(camaddr,eldenring.exe,0F 29 37 80 BB 15 03 00 00 00) // should be unique
alloc(newmem,$1000,camaddr)
registersymbol(camadr)
registersymbol(startfreecam)

label(code)
label(return)

newmem:
  mov [camadr],rdi
code:
  cmp byte ptr [startfreecam],1
  jne @f
  movaps [rdi],xmm6
@@:
  cmp byte ptr [rbx+00000315],00
  jmp return
camadr:
dq 0
startfreecam:
db 1
camaddr:
  jmp newmem
  nop 5
return:
registersymbol(camaddr)




aobscanmodule(CamRotation,eldenring.exe,0F 29 A6 50 01 00 00 41 0F 28) // should be unique
alloc(newmem2,$1000,CamRotation)
registersymbol(bAutoCam)

label(code2)
label(return2)

newmem2:
cmp byte ptr [bAutoCam],1
jne return2
code2:
  movaps [rsi+00000150],xmm4
  jmp return2
bAutoCam:
db 1
CamRotation:
  jmp newmem2
  nop 2
return2:
registersymbol(CamRotation)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(pCoordTemp)
unregistersymbol(pCoordAdr)
unregistersymbol(pCoordTemp)
unregistersymbol(startfreecam)

camaddr:
  db 0F 29 37 80 BB 15 03 00 00 00

  unregistersymbol(camadr)
unregistersymbol(camaddr)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: eldenring.exe+3B1C8C

