                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(spell_req,eldenring.exe,44 0f b6 68 ? 45 0f b6 c5 ba ? ? ? ? e9 ? ? ? ? 81 fb ? ? ? ? 75 ? 48 8d 4c 24) // should be unique
alloc(newmem,$1000,spell_req)

label(code)
label(return)

newmem:
  mov byte ptr [rax+21], 1            //slots
  mov byte ptr [rax+22], 0            //Int
  mov byte ptr [rax+23], 0            //Faith
  mov byte ptr [rax+0E], 0            //arcane
code:
  movzx r13d,byte ptr [rax+0E]
  jmp return

spell_req:
  jmp newmem
return:
registersymbol(spell_req)

[DISABLE]

spell_req:
  db 44 0F B6 68 0E

unregistersymbol(spell_req)
dealloc(newmem)

