                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game   : eldenring.exe
  Version:
  Date   : 2022-02-26
  Author : Team Hexinton
}
[ENABLE]
aobScanModule(FaceEditor,eldenring.exe,0F B6 83 AC 00 00 00 88 87 AC 00 00 00 0F B6 83 AD 00 00 00 88 87 AD 00 00 00 0F B6 83 AE 00 00 00 88 87 AE 00 00 00 0F)
//aobScanRegion(FaceEditor1,FaceEditor+1000,FaceEditor+5000000,0F B6 83 AC 00 00 00 88 87 AC 00 00 00 0F B6 83 AD 00 00 00 88 87 AD 00 00 00 0F B6 83 AE 00 00 00 88 87 AE 00 00 00 0F)
aobScanModule(FaceAccessor,eldenring.exe,48 89 85 98 00 00 00 48 8B DA 48 89 54 24 38 4C 8B F9 48 8D 71 10 48 83 3E 00)
label(FaceLog)
registersymbol(FaceLog)
alloc(FaceHook,4096,FaceAccessor)
define(goback,FaceAccessor+7)
FaceHook:
mov [rbp+00000098],rax
lea rbx,[FaceLog]
lea rsi,[FaceHook+FF8]
loopstart:
cmp [rbx],rax
je goback
cmp qword ptr[rbx],0
jne loopnext
mov [rbx],rax
jmp goback
loopnext:
add rbx,8
cmp rbx,rsi
jbe loopstart
jmp goback

FaceEditorHook:
mov [FaceLog-8],rbx
movzx eax,byte ptr [rbx+000000AC]
ret
align 8
dq 0
FaceLog:

FaceEditor:
call FaceEditorHook
nop
nop
//FaceEditor1:
//call FaceEditorHook
FaceAccessor:
jmp FaceHook
[DISABLE]
FaceEditor:
db 0F B6 83 AC 00 00 00 88 87 AC 00 00 00 0F B6 83 AD 00 00 00 88 87 AD 00 00 00 0F B6 83 AE 00 00 00 88 87 AE 00 00 00 0F
//FaceEditor1:
//db 0F B6 83 AC 00 00 00 88 87 AC 00 00 00 0F B6 83 AD 00 00 00 88 87 AD 00 00 00 0F B6 83 AE 00 00 00 88 87 AE 00 00 00 0F
FaceAccessor:
db 48 89 85 98 00 00 00 48 8B DA 48 89 54 24 38 4C 8B F9 48 8D 71 10 48 83 3E 00
unregistersymbol(FaceLog)
dealloc(FaceHook)

</AssemblerScript>
