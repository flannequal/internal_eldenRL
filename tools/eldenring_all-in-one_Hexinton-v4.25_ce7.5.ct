                      <ID>1337192859</ID>
                      <Description>"CharaInitSwap"</Description>
                      <Options moHideChildren="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{Author:Pavuk Edited by Pyre}
[ENABLE]
aobscanmodule(CharInitFunc,eldenring.exe,48 8B C4 57 48 83 EC 70 48 C7 40 ? FE FF FF FF 48 89 58 ? 48 89 68 ? 48 89 70 ? 8B F2 48 8B E9)
registersymbol(CharInitFunc)
alloc(CharaInitSwap,512,eldenring.exe)
registersymbol(CharaInitSwap)
alloc(CharaInitParamID,4)
registersymbol(CharaInitParamID)

CharaInitParamID:
 dd #9000

CharaInitSwap:
 sub   rsp, 38
 mov   rcx, [GameDataMan]
 mov   rax, [CharaInitParamID]
 mov   edx, eax
 call  CharInitFunc
 add   rsp, 38
 ret
[DISABLE]
dealloc(CharaInitSwap)
unregistersymbol(CharaInitSwap)
dealloc(CharaInitParamID)
unregistersymbol(CharaInitParamID)
unregistersymbol(CharInitFunc)
</AssemblerScript>
