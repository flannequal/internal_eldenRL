          <AssemblerScript>//Made By Sapphire
{$LUA}
if syntaxcheck then return end
[ENABLE]
local function isAmericanDateFormat(dateStr)
    local month, day, year = dateStr:match("(%d+)-(%d+)-(%d+)")
    if month and day and year and #year == 4 then
        return tonumber(month) &lt;= 12 and tonumber(day) &lt;= 31
    end
    return false
end

local function getFormattedDateTime()
    local dateStr = os.date("%x"):gsub("/", "-")
    local timeStr
    local formattedDate

    if isAmericanDateFormat(dateStr) then
        local month, day, year = dateStr:match("(%d+)-(%d+)-(%d+)")
        formattedDate = month .. "-" .. day .. "-" .. year
        timeStr = os.date("%I-%M-%S %p")
    else
        local day, month, year = os.date("%d"), os.date("%m"), os.date("%Y")
        formattedDate = day .. "-" .. month .. "-" .. year
        timeStr = os.date("%H-%M-%S")
    end

    return formattedDate .. " " .. timeStr
end

local datetimef = getFormattedDateTime()
local userProfile = os.getenv("USERPROFILE")
local appData = os.getenv("APPDATA")
local sourcePath = appData .. "\\EldenRing"
local destPath = userProfile .. "\\Desktop\\Elden Ring Backup " .. datetimef .. ".zip"

local destFolder = destPath:match("(.*)\\")
if destFolder then
    os.execute('mkdir "' .. destFolder .. '"')
end

local tarCommand = string.format('tar -acf "%s" "%s"', destPath, sourcePath)

shellExecute('cmd.exe', '/C ' .. tarCommand)

local message = 'Backup created at ' .. destPath .. '\n\nTo restore backup, unpack archive to ' .. sourcePath .. ' and overwrite save file\n\n'
messageDialog(message, mtInformation, mbOK)
