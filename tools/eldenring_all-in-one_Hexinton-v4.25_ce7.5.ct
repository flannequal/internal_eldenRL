{$lua}
function disableSelf(sender)
  sender.destroy()
  local addr=getAddressList().getMemoryRecordByDescription("Enable FastTravel In Dungeons")
  memoryrecord_unfreeze(addr)
end

local t=createTimer(nil)
t.OnTimer=disableSelf
t.Interval=100
t.Enabled=true
{$asm}


[FieldArea]+A0:

dd 0
 
 
[DISABLE]

</AssemblerScript>
