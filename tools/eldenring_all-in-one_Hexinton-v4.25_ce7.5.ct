aobscanmodule(bmjrq,eldenring.exe,44 84 04 01 41 0F 95 C1) // should be unique
alloc(newmem,$1000,bmjrq)

label(code)
label(return)

newmem:
cmp dword [r10+20],7d
jne code
mov r9,rax
sub r9,qword[r10+28]
cmp r9,2710
jne code
cmp ecx,4
jne code
or byte [rcx+rax],40
code:
xor r9,r9
test [rcx+rax],r8l
setne r9l
jmp return

bmjrq:
jmp newmem
nop 3
return:
registersymbol(bmjrq)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
bmjrq:
  db 44 84 04 01 41 0F 95 C1

unregistersymbol(bmjrq)
dealloc(newmem)

