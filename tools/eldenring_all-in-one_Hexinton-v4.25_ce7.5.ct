                          <ID>1337192860</ID>
                          <Description>"Swap_Chr!"</Description>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>[enable]
{$lua}
function disableSelf(timer)
  timer.destroy()
  local addr=getAddressList().getMemoryRecordByDescription("Swap_Chr!")
  memoryrecord_unfreeze(addr)
end
local t=createTimer(nil)
t.OnTimer=disableSelf
t.Interval=100
t.Enabled=true
{$asm}
CREATETHREAD(CharaInitSwap)
[disable]
</AssemblerScript>
