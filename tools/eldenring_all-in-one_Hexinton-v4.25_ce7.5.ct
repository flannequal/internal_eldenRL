                <CheatEntry>
                  <ID>1337309222</ID>
                  <Description>"Resistance Multipliers"</Description>
                  <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(resistandmore,eldenring.exe,66 0f 6e 89 ? ? ? ? 66 0f 6e 81 ? ? ? ? 0f 5b c9 0f 5b c0 f3 0f 5e c8 0f 2f d1) // should be unique
alloc(newmem,$1000,resistandmore)
alloc(resistmore,8)

label(code)
label(return)
label(resistandmoreread)
registersymbol(resistandmoreread)
registersymbol(resistmore)
label(set_res_current)
registersymbol(set_res_current)

newmem:
  push rdx
  push rsi
  mov rdx, rax
  mov [resistmore], rdx
  cmp [set_res_current], 00000001
  jne code
  mov rdx, [rdx+20]            //CS::CSChrResistModule
  test rdx, rdx
  je code
  mov rsi, [rdx+2C]            //max
  mov [rdx+10],rsi             //current
  mov rsi, [rdx+30]            //max
  mov [rdx+14],rsi             //current
  mov rsi, [rdx+34]            //max
  mov [rdx+18],rsi             //current
  mov rsi, [rdx+38]            //max
  mov [rdx+1C],rsi             //current
  mov rsi, [rdx+3C]            //max
  mov [rdx+20],rsi             //current
  mov rsi, [rdx+40]            //max
  mov [rdx+24],rsi             //current
  mov rsi, [rdx+44]            //max
  mov [rdx+28],rsi             //current
code:
  pop rsi
  pop rdx
  readmem(resistandmore,8)
  jmp return

resistandmoreread:
 readmem(resistandmore,8)

set_res_current:
 dd 0

resistandmore:
  jmp newmem
  nop 3
return:
registersymbol(resistandmore)

[DISABLE]

resistandmore:
  readmem(resistandmoreread,8)

unregistersymbol(*)
dealloc(*)

