unregistersymbol(SpawnedEnemy)

dealloc(DbgChrCount)
unregistersymbol(DbgChrCount)
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>1987705402</ID>
                  <Description>"[Character Spawner]"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local ChrPtr3
local ChrOffset
local ChrPtrOffset

function GetPtr_3()  --above rendMan
     if (readByte("eldenring.exe+3D7085A") == 0) then
       ChrPtr3 = "WorldChrMan"
       ChrPtr3 = readQword(ChrPtr3)
       ChrPtr3 = ChrPtr3 + 0x1E268
       ChrPtr3 = readQword(ChrPtr3)
       ChrPtr3 = ChrPtr3 + 0x18
       ChrPtr3 = readQword(ChrPtr3)
       ChrPtrOffset = ChrPtr3
       ChrOffset = readInteger("SpawnedEnemy+0x10")
       ChrOffset = ChrOffset * 0x10
       ChrPtrOffset = ChrPtrOffset + ChrOffset
       writeQword("SpawnedEnemy+0x8", ChrPtrOffset)
       ChrPtr3 = ChrPtr3 + ChrOffset
       ChrPtr3 = readQword(ChrPtr3)
       writeQword("SpawnedEnemy", ChrPtr3)
     else
       disableSelf1()
     return end
end

GetPtr_3()
if(Ptr3Timer == nil) then
  Ptr3Timer = createTimer(getMainForm())
  Ptr3Timer.Interval = 150
  Ptr3Timer.OnTimer = function(timer)
    GetPtr_3()
  end
end
Ptr3Timer.setEnabled(true)

function disableSelf1()
  local addr=getAddressList().getMemoryRecordByDescription("[Character Spawner]")
  memoryrecord_unfreeze(addr)
end
{$asm}
alloc(AlecSelects, 4)
registerSymbol(AlecSelects)
AlecSelects:
dd #0

[DISABLE]
{$lua}
if syntaxcheck then return end
if Ptr3Timer ~= nil then
  Ptr3Timer.setEnabled(false)
end
</AssemblerScript>
