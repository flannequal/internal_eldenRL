                <CheatEntry>
                  <ID>106829</ID>
                  <Description>"Get param list as table and print it"</Description>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local p = paramUtils:printParams(true) -- set to true to return as table
print(table.concat(p,"\n"))
disableMemrec(memrec)
[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>106830</ID>
                  <Description>"Find address by ID in a param"</Description>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{
  Author: Igromanru
  Description: Searches for an address by ID in a param
}
{$lua}
if syntaxcheck then return end
[ENABLE]
local id =  --enter ID
local paramName = "" -- enter Param Name here
--------------------------------------------------------
local address = paramUtils:getIdAddressInParam(paramName, id)
if(address ~= nil and address &gt; 0) then
  print("Your address is "..address.." (0x"..paramUtils:toHex(address)..")")
else
  print("The address for ID "..id.." (0x"..paramUtils:toHex(id)..") couldn't be found in param "..paramName)
end
disableMemrec(memrec)
[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>106831</ID>
                  <Description>"Find ID by address in any param"</Description>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{
  Author: Igromanru
  Description: Searches for an ID by address in all params
}
{$lua}
if syntaxcheck then return end
[ENABLE]
local address = 0x --enter address to search for the ID
--------------------------------------------------------
local id = paramUtils:getIdByAddressInAnyParam(address)
if(id ~= nil and id &gt; 0) then
  print("Your ID is "..id.."(0x"..paramUtils:toHex(id)..")")
end
disableMemrec(memrec)
[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>106832</ID>
                  <Description>"Find ID by address in specific param"</Description>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{
  Author: Igromanru
  Description: Searches for an ID by address in a param
}
{$lua}
if syntaxcheck then return end
[ENABLE]
local address = 0x --enter address to search for the ID
local paramName = "" -- enter Param Name here
--------------------------------------------------------
local id = paramUtils:getIdFromAddressInParam(paramName, address)
if(id ~= nil) then
  print("Your ID is "..id.."(0x"..paramUtils:toHex(id)..")")
end
disableMemrec(memrec)
[DISABLE]
</AssemblerScript>
