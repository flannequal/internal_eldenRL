              <ID>106836</ID>
              <Description>"Param Scripting"</Description>
              <LastState Value="" RealAddress="00000000"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>106837</ID>
                  <Description>"C"</Description>
                  <LastState Value="" RealAddress="00000000"/>
                  <GroupHeader>1</GroupHeader>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>106838</ID>
                      <Description>"Example C Param Patcher script: Double somber weapon base damage"</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{cscript ontimeout=break gensymbols=true}
// Example C Param Patcher script: Double somber weapon base damage
// Requires CSCRIPT extensions
[ENABLE]
{$c}
#include &lt;tga/params.h&gt;
int on_enable() {
    ParamPatchBegin("double_dmg");
    ParamPatchAll(EquipParamWeapon, {
        if (param-&gt;originEquipWep1 != -1 &amp;&amp; param-&gt;originEquipWep16 == -1) {
            param-&gt;attackBasePhysics *= 2;
            param-&gt;attackBaseMagic *= 2;
            param-&gt;attackBaseFire *= 2;
            param-&gt;attackBaseThunder *= 2;
            param-&gt;attackBaseStamina *= 2;
        }
    });
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("double_dmg");
    return 0;
}

{$asm}
[DISABLE]

</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>106839</ID>
                      <Description>"Deathblight Daggers"</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{cscript}
[ENABLE]
{$c}
#include &lt;tga/params.h&gt;
int on_enable() {
    ParamPatchBegin("deathblight_dagger");
    ParamPatchAll(EquipParamWeapon, {
        if (param-&gt;weaponCategory == 0) {
            param-&gt;residentSpEffectId2 = 70;
        }
    });
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("deathblight_dagger");
    return 0;
}

{$asm}
[DISABLE]

</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>106840</ID>
                      <Description>"Custom FOV for specific cases"</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{cscript}
[ENABLE]
{$c}
#include &lt;tga/params.h&gt;
int on_enable() {
    ParamPatchBegin("custom_fov_alt");
    ParamPatch(LockCamParam, 0, param-&gt;camFovY = 60;); // on foot
    ParamPatch(LockCamParam, 1, param-&gt;camFovY = 55;); // on foot - lock-on
    ParamPatch(LockCamParam, 1000, param-&gt;camFovY = 70;); // horse
    ParamPatch(LockCamParam, 1001, param-&gt;camFovY = 65;); // horse - lock-on
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("custom_fov_alt");
    return 0;
}

{$asm}
[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>106841</ID>
                      <Description>"Blaidd the Half-Wolf"</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{cscript}
[ENABLE]
{$c}
#include &lt;tga/params.h&gt;
int on_enable() {
    ParamPatchBegin("blaidd_summon");
    ParamPatch(BuddyParam, 20200000, {
        param-&gt;npcParamId = 20109110;
        param-&gt;npcThinkParamId = 20108000;
        param-&gt;generateAnimId = 20039;
    });
    ParamPatch(NpcParam, 20109110, {
        param-&gt;teamType = 47;
        param-&gt;spEffectID2 = 5130;
        param-&gt;spEffectID4 = 4302;
        param-&gt;spEffectID5 = 295000;
        param-&gt;spEffectID6 = 296000;
        param-&gt;spEffectID7 = 297000;
    });
    for (int id = 202000; id &lt;= 202010; id++ ) {
        ParamPatch(EquipParamGoods, id, {
            param-&gt;iconId = 13170;
            param-&gt;consumeMP = -1;
        });
    }
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("blaidd_summon");
    return 0;
}

{$asm}
[DISABLE]

</AssemblerScript>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
                <CheatEntry>
                  <ID>106842</ID>
                  <Description>"Lua"</Description>
                  <LastState Value="" RealAddress="00000000"/>
                  <GroupHeader>1</GroupHeader>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>106843</ID>
                      <Description>"Discardable items"</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>//Author: inuNorii
//Allow discarding any items
[ENABLE]
{$lua}
if syntaxcheck then return end
local weapon = EquipParamWeapon:new("discardableItems")
weapon:patchAllBinary(0x109,1,1)

local protector = EquipParamProtector:new("discardableItems")
protector:patchAllBinary(0xE3,1,0)

local accessory = EquipParamAccessory:new("discardableItems")
accessory:patchAllBinary(0x40,1,3)

local goods = EquipParamGoods:new("discardableItems")
goods:patchAllBinary(0x49,1,3)

[DISABLE]
{$lua}
if syntaxcheck then return end
paramUtils:restore("discardableItems")
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>106844</ID>
                      <Description>"Blaidd the Half-Wolf Spirit Ash"</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>//Author: inuNorii
//Replaces Banished Knight Engvall with Blaid the Half-Wolf
{$lua}
if syntaxcheck then return end
[ENABLE]
local buddy = BuddyParam:new("blaiddSummon",20200000)
buddy:npcParamId(20109110)
buddy:npcThinkParamId(20108000)
buddy:generateAnimId(20039)

local npc = NpcParam:new("blaiddSummon",20109110)
npc:patchByte(0x133,47) -- TeamType
npc:patch4Byte(0x54,5130) -- SpEffectID2
npc:patch4Byte(0x5C,4302) -- SpEffectID4
npc:patch4Byte(0x60,295000) -- SpEffectID5
npc:patch4Byte(0x64,296000) -- SpEffectID6
npc:patch4Byte(0x68,297000) -- SpEffectID7

local goods = {
  202000, 202001, 202002, 202003, 202004, 202005,
  202006, 202007, 202008, 202009, 202010
}
for i,id in ipairs(goods) do
local goods = EquipParamGoods:new("blaiddSummon",id)
goods:iconId(13170)
goods:consumeMP(-1)
end

[DISABLE]
paramUtils:restore("blaiddSummon")
</AssemblerScript>
                    </CheatEntry>
