		if dlc == 1 then
			if (warpId &gt;= 20001950 and warpId &lt;= 43011951) or (warpId &gt;= 2045411950 and warpId &lt;= 2051481951) then
				return true
			end
		end
		return false
	end

	local CSLuaEventManager = readPointer("CSLuaEventManager")
