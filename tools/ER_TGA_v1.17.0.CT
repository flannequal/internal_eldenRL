// sfix's script for DS3, adapted to ER
[Enable]
{$c}
#include &lt;tga/params.h&gt;
int on_enable() {
    ParamPatchBegin("faster_invasions");
    ParamPatch(NetworkParam, 0, {
        param-&gt;maxBreakInTargetListCount = 20;
        param-&gt;breakInRequestIntervalTimeSec = 10;
        param-&gt;breakInRequestTimeOutSec = 5;
    });
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("faster_invasions");
    return 0;
}
{$asm}
[Disable]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>101262</ID>
                  <Description>"No Phantom Finger Auto-Equip"</Description>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{cscript}
[Enable]
{$c}
#include &lt;tga/params.h&gt;
int on_enable() {
    ParamPatchBegin("no_phantom_finger");

    int goods[] = { 107, 113, 114 };
    for (int i = 0; i &lt; sizeof(goods) / sizeof(int); i++) {
        ParamPatch(EquipParamGoods, goods[i], { param-&gt;isAutoEquip = 0; });
    }
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("no_phantom_finger");
    return 0;
}
{$asm}
[Disable]
</AssemblerScript>
