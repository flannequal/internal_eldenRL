                    </CheatEntry>
                    <CheatEntry>
                      <ID>101151</ID>
                      <Description>"Remove multiple"</Description>
                      <LastState Value="" RealAddress="00000000"/>
                      <GroupHeader>1</GroupHeader>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>101152</ID>
                          <Description>"Remove All Duplicates (Player inventory)"</Description>
                          <LastState/>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local GameDataMan = readPointer("GameDataMan")
local PlayerGameData = readPointer(GameDataMan + 0x8)
local EquipInventoryData = readPointer(PlayerGameData + 0x5D0)

local inventoryList = readPointer(EquipInventoryData + 0x10)
local inventoryNum = readInteger(EquipInventoryData + 0x18)

local items = {}

local itemCount = 0
for i=0,2688 do
    local item = getAddress(inventoryList + i * 0x18)
    local itemId = readInteger(item + 4)
    if itemId ~= 0xFFFFFFFF then
		if (itemId &lt; 0x40000000 or itemId &gt;= 0x80000000) and inArray(items, itemId) then
			RemoveItem(i, 0)
		else
			table.insert(items, itemId)
		end
        itemCount = itemCount + 1
	end
    if itemCount &gt;= inventoryNum then break end
end
disableMemrec(memrec)
[DISABLE]
</AssemblerScript>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>101153</ID>
                          <Description>"Remove All Duplicates (Chest)"</Description>
                          <LastState/>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local GameDataMan = readPointer("GameDataMan")
local PlayerGameData = readPointer(GameDataMan + 0x8)
local EquipInventoryData = readPointer(PlayerGameData + 0x8D0)

local inventoryList = readPointer(EquipInventoryData + 0x10)
local inventoryNum = readInteger(EquipInventoryData + 0x18)

local items = {}

local itemCount = 0
for i=0,1920 do
    local item = getAddress(inventoryList + i * 0x18)
    local itemId = readInteger(item + 4)
    if itemId ~= 0xFFFFFFFF then
		if (itemId &lt; 0x40000000 or itemId &gt;= 0x80000000) and inArray(items, itemId) then
			RemoveItem(i, 1)
		else
			table.insert(items, itemId)
		end
        itemCount = itemCount + 1
	end
    if itemCount &gt;= inventoryNum then break end
end
disableMemrec(memrec)
[DISABLE]
</AssemblerScript>
