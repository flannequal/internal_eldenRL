  <LuaScript>-- === CONFIG ===
local OUT = "C:\\elden_graces.json"   -- change path as you like

-- Resolve FMG text IDs → strings (uses MsgRepository in most ER tables)
local function text_by_id(textId)
  -- If your table has a helper: return getTextById(textId)
  -- Fallback: try MsgRepository if registered
  local msgRepo = getAddressSafe("MsgRepository")
  if msgRepo == nil then return tostring(textId) end
  -- many tables expose a Lua helper; if not, return the numeric id
  return tostring(textId)
end

-- Iterate BonfireWarpParam rows.
-- Replace the body of `for_each_bonfire_row` if your table exposes a different API.
local function for_each_bonfire_row(cb)
  -- Common pattern in TGA/Hexington tables:
  --   ParamRepo:forEach("BonfireWarpParam", function(uuid, id, addr) ... end)
  -- If you have such a function, call it here instead of the placeholder.
  if not BonfireWarpParam then error("BonfireWarpParam class not loaded") end

  -- Heuristic fallback: many tables expose `Param.ForEachRows("BonfireWarpParam", cb)`
  local f = _G.ForEachParamRow or _G.forEachParamRow or _G.ParamForEach or nil
  if f then
    f("BonfireWarpParam", function(uuid, id, addr) cb(id, addr) end)
    return
  end

  -- If your table provides a list of params:
  local listFunc = _G.GetParamRows or _G.getParamRows
  if listFunc then
    local rows = listFunc("BonfireWarpParam")
    for _, row in ipairs(rows) do
      cb(row.id, row.address)
    end
    return
  end

  error("Please wire up for_each_bonfire_row() to your table's param-iteration helper")
end

-- Read a 4-byte field from a row base
local function r32(addr, off) return readInteger(addr + off) end

local function export_all_graces_json(path)
  local fh = assert(io.open(path, "w"))
  fh:write("{\n  \"graces\": [\n")
  local first = true

  for_each_bonfire_row(function(id, base)
    -- Fields per your class:
    -- 0x00 LocationEventId
    -- 0x04 WarpEventId
    -- 0x08 BonfireNameId  (text FMG id)
    -- 0x0C DescriptionTextId
    -- 0x10 PictureId
    -- 0x14 ListId (byte)
    -- 0x15 IsDisableQuickwarp (byte)
    -- 0x16 CeremonyId (u16)
    -- 0x18 onlineAreaId (u32)

    local locationEventId   = r32(base, 0x00)
    local warpEventId       = r32(base, 0x04)
    local bonfireNameTextId = r32(base, 0x08)
    local name              = text_by_id(bonfireNameTextId)

    -- Most cheat tables (including yours) use "warpId" values like 1042362951 etc.
    -- In many setups warpId == locationEventId or warpEventId; keep both for safety.
    local entry = string.format(
      '    {"id": %d, "warpEventId": %d, "locationEventId": %d, "nameTextId": %d, "name": "%s"}',
      id, warpEventId, locationEventId, bonfireNameTextId, (name:gsub('"','\\"'))
    )
    if not first then fh:write(",\n") else first=false end
    fh:write(entry)
  end)

  fh:write("\n  ]\n}\n")
  fh:close()
  print("Exported graces → "..path)
end

export_all_graces_json(OUT)


</LuaScript>
</CheatTable>
