                    <CheatEntry>
                      <ID>103530</ID>
                      <Description>"Find Address"</Description>
                      <Options moHideChildren="1"/>
                      <LastState/>
                      <Color>FF0000</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
aobscanmodule(SpEffect,$process,F3 0F59 71 08)
registersymbol(SpEffect)

aobscanmodule(Bullet,$process,8B 18 45 85 F6)
registersymbol(Bullet)

aobscanmodule(Attack,$process,0FB6 41 72 EB 0F)
registersymbol(Attack)

aobscanmodule(Throw,$process,8B 40 24 C3 C3)
registersymbol(Throw)

[DISABLE]
unregistersymbol(SpEffect)
unregistersymbol(Bullet)
unregistersymbol(Attack)
unregistersymbol(Throw)
</AssemblerScript>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>103531</ID>
                          <Description>"How to"</Description>
                          <LastState/>
                          <Color>0000FF</Color>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
disableMemrec(memrec)
showText("How to use Find Address",[[
1. Select a param
2. Memory view window will open up with selected param at the top
3. Right-click it and choose "Find out what addresses this instruction accesses"
4. Right-click one of the results and select "Copy address to clipboard" or hit Ctrl+C
5. Paste the address into the relevant helper
]])

[DISABLE]

</AssemblerScript>
