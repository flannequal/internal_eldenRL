                  <Options moHideChildren="1"/>
                  <LastState Value="" RealAddress="00000000"/>
                  <Color>FF8000</Color>
                  <GroupHeader>1</GroupHeader>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>106861</ID>
                      <Description>"Check if a Flag is Set"</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
local id = 62000 -- the id of the flag to check

if ef.getFlag(id):getValue() then
	print(id.." is set!")
else
	print(id.." is not set!")
end
disableMemrec(memrec)

[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>106862</ID>
                      <Description>"Set Flag with ID"</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
local id = 62000 -- the id of the flag to set
local state = 1 -- the state to set, 0/1 or false/true

state = state and state ~= 0 and 1 or 0
ef.setFlag(id, state)
print(string.format("The state of event flag %s is now %s", id, ef.getFlag(id):getValue()))
disableMemrec(memrec)

[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>106863</ID>
                      <Description>"Print Flags in Range"</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
local start = 62000 -- the id of the first flag in a flag range
local range = 100 -- the number of flags after the first flag to check
local state = 1 -- the state to check for, 0/1 or false/true

ef.runThread = true
local thread = createThread(function()
  local total = start + range
  local state = state and state ~= 0 and 1 or 0
  local r = {}
  local p1, p2 = 0, 0
  local t = os.clock()
  for id = start, total do
	  if not ef.runThread then break end
    if booltonumber(ef.getFlag(id):getValue()) == state then table.insert(r, id) end
    p1 = (id - start)*100//range
    if p1 ~= p2 then print(p1.."% "..(os.clock() - t)*100//1/100) p2 = p1 end
  end
  print(string.format("Found %s flags with state %s in range %s-%s:", #r, state, start, start + range))
  for i,v in ipairs(r) do print(v) end
	ef.runThread = false
end)
disableMemrec(memrec, function() return not ef.runThread end)

[DISABLE]
ef.runThread = false
