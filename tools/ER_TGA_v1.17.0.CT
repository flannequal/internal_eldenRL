//Author: Gáté
[ENABLE]
{$c}
#include &lt;tga/params.h&gt;
int on_enable() {
    ParamPatchBegin("no_upgrade_cost");
    ParamPatchAll(EquipMtrlSetParam, {
        param-&gt;materialId01 = -1;
        param-&gt;itemNum01 = -1;
    });
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("no_upgrade_cost");
    return 0;
}

{$asm}
